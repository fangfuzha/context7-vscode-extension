{
	"name": "context7-mcp",
	"displayName": "Context7 MCP Server",
	"description": "Real-time code and documentation access for AI assistants via Context7 MCP server",
	"version": "1.1.0",
	"publisher": "Upstash",
	"private": true,
	"icon": "context7logo.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/upstash/context7-vscode-extension.git"
	},
	"engines": {
		"vscode": "^1.101.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"keywords": [
		"mcp",
		"context7",
		"documentation",
		"ai",
		"coding"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"mcpServerDefinitionProviders": [
			{
				"id": "upstash/context7",
				"label": "Context7"
			}
		],
		"configuration": {
			"title": "Context7",
			"properties": {
				"context7.apiKey": {
					"type": "string",
					"default": "",
					"markdownDescription": "Optional Context7 API key for higher rate limits and access to private repositories. Get one at [context7.com/dashboard](https://context7.com/dashboard)."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.101.0",
		"typescript": "^5.8.2"
	}
}
